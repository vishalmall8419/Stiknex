{
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?action=login"
    },
    {
      "source": "/api/auth/setup-2fa",
      "destination": "/api/auth?action=setup-2fa"
    },
    {
      "source": "/api/admin-blogs",
      "destination": "/api/blogs?admin=true"
    },
    {
      "source": "/api/dashboard-trends",
      "destination": "/api/trends?view=dashboard"
    },
    {
      "source": "/api/trends-admin",
      "destination": "/api/trends?view=admin"
    },
    {
      "source": "/api/latest-keywords",
      "destination": "/api/trends?view=keywords"
    },
    {
      "source": "/api/external-services",
      "destination": "/api/seo-stats?action=monitor-external"
    },
    {
      "source": "/api/monitor-external",
      "destination": "/api/seo-stats?action=monitor-external"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/render-page?slug=$1&type=blog"
    },
    {
      "source": "/((?!api/)(?!.*\\.).*)",
      "destination": "/api/render-page?path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/fetch-trends",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/generate-blog",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  }
}
