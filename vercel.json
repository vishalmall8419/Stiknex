{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/fetch-trends",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/generate-blog",
      "schedule": "0 3 * * *"
    }
  ]
}
