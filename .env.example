# Required by the Vercel API for persistent encrypted Google Calendar token storage.
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=your-existing-admin-jwt-secret

GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_REDIRECT_URI=your-exact-google-oauth-callback-url
# Local: http://localhost:5174/api/google-calendar/callback
# Vercel Production: https://stiknex.site/api/google-calendar/callback
# Generate a unique base64-encoded 32-byte key; never reuse this example or commit a real key.
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-unique-base64-encoded-32-byte-key
