<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS across the entire application and disable cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicit configuration for trusted Stiknex domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">stiknex.site</domain>
        <domain includeSubdomains="true">stiknex.vercel.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>

